# Build stage
FROM golang:1.24-alpine AS builder

WORKDIR /usr/src/telegram-bot

# Install build dependencies
RUN apk add --no-cache git

# Download dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -o /telegram-bot cmd/telegram-bot/main.go

# Final stage
FROM alpine:latest

# Install runtime dependencies
RUN apk --no-cache add \
    ca-certificates \
    ffmpeg \
    python3 \
    py3-pip \
    yt-dlp

WORKDIR /root/

# Copy the binary from builder
COPY --from=builder /telegram-bot .

# Copy locales
COPY cmd/locales cmd/locales

# Copy environment file (will be overridden by docker-compose)
COPY .env .

# Expose the port the app runs on
EXPOSE 8080/tcp

# Command to run the executable
CMD ["./telegram-bot"]
